# Network (defaults: Onyx testnet)
GNO_RPC=https://rpc.onyx.testnets.gno.land
GNO_CHAIN_ID=onyx-1
GNO_WEB=https://onyx.testnets.gno.land
ASSAY_REGISTRY=gno.land/r/nym-assay001/registry

# Signing. Leave GNOKEY_NAME empty and execute_verified_package returns the
# exact gnokey command instead of broadcasting.
GNOKEY_NAME=
GNOKEY_HOME=
GNOKEY_BIN=gnokey
# Optional. Prefer typing the password yourself; never commit a real one.
GNOKEY_PASSWORD=
